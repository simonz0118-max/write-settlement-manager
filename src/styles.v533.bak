
:root{--bg:#f5f5f7;--panel:#fff;--text:#111318;--muted:#737784;--line:#e5e6eb;--line2:#d8dae2;--purple:#6257ff;--purple2:#9a55f6;--red:#ff3b30;--green:#34c759;--orange:#ff9f0a;--shadow:0 14px 40px rgba(39,42,54,.06);--shadow2:0 6px 18px rgba(39,42,54,.06)}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","PingFang SC","Helvetica Neue",Arial,sans-serif;color:var(--text);background:var(--bg)}button,input,select{font:inherit}button{cursor:pointer}.app-shell{min-height:100vh;display:grid;grid-template-columns:220px 1fr}.sidebar{position:fixed;inset:0 auto 0 0;width:220px;background:rgba(255,255,255,.94);border-right:1px solid var(--line);padding:22px 16px 18px;display:flex;flex-direction:column;z-index:20}.brand{display:flex;align-items:center;gap:10px;padding:0 8px 20px}.brand-logo{width:58px;height:58px;object-fit:contain;mix-blend-mode:multiply}.brand-copy{display:grid}.brand-copy strong{font-size:20px;letter-spacing:.04em}.brand-copy span{font-size:10px;color:#4d515b}.brand-copy small{font-size:9px;color:#8c9099;margin-top:3px}.side-nav{display:grid;gap:4px}.nav-item{border:0;background:transparent;border-radius:10px;padding:11px 12px;display:flex;align-items:center;gap:11px;text-align:left;font-size:12px;color:#343742}.nav-item span{width:20px;text-align:center;color:#555a66}.nav-item:hover{background:#f4f4f8}.nav-item.active{color:#504dff;background:#f0efff;font-weight:650}.nav-item b{margin-left:auto;background:#ff9f0a;color:white;padding:2px 6px;border-radius:99px;font-size:8px}.side-tip{margin-top:auto;border:1px solid var(--line);border-radius:12px;padding:13px;background:#fff}.side-tip b{font-size:11px}.side-tip ol{margin:9px 0 0;padding-left:17px;color:var(--muted);font-size:9px;line-height:1.8}.side-status{margin-top:10px;border:1px solid var(--line);border-radius:12px;padding:12px;background:#fff;display:grid;gap:7px}.side-status>div{display:flex;align-items:center;gap:7px;font-size:10px}.side-status i{width:7px;height:7px;background:var(--green);border-radius:50%}.side-status small{font-size:8.5px;color:var(--muted)}.side-status button{border:1px solid var(--line2);background:#fff;border-radius:8px;padding:8px;font-size:9px}.side-status button:disabled{opacity:.45}.workspace{grid-column:2;min-width:0}.topbar{height:64px;padding:0 28px;display:flex;align-items:center;justify-content:flex-end;border-bottom:1px solid rgba(229,230,235,.85);background:rgba(245,245,247,.78);backdrop-filter:blur(18px);position:sticky;top:0;z-index:12}.top-title{position:absolute;left:50%;transform:translateX(-50%);font-size:10px;color:#656977}.top-actions{display:flex;gap:8px}.ghost-btn,.danger-btn,.dark-btn{border-radius:9px;padding:9px 13px;font-size:9.5px;background:#fff;border:1px solid var(--line2)}.danger-btn{color:var(--red);border-color:#ffc6c2}.dark-btn{background:#16171a;color:white;border-color:#16171a}.content{padding:22px 28px 44px;max-width:1500px;margin:auto}.landing{max-width:1210px;margin:12px auto 0}.landing-hero,.dashboard-hero{min-height:430px;background:linear-gradient(120deg,#fff 0%,#fff 52%,#f3f2ff 100%);border:1px solid #ececf1;border-radius:20px;box-shadow:var(--shadow);display:grid;grid-template-columns:1.12fr .88fr;overflow:hidden;position:relative}.dashboard-hero{min-height:350px;margin-bottom:18px}.hero-copy{padding:52px 30px 45px 52px;position:relative;z-index:2}.hero-copy.compact{padding:38px 24px 34px 44px}.eyebrow{font-size:9px;letter-spacing:.14em;color:#7f8290;font-weight:650}.hero-copy h1{font-size:48px;line-height:1.03;letter-spacing:-.055em;margin:13px 0 18px}.hero-copy.compact h1{font-size:42px}.hero-copy h1 em{font-style:normal;background:linear-gradient(90deg,#5765ff,#9a55f6);-webkit-background-clip:text;color:transparent}.hero-copy>p{font-size:12px;line-height:1.8;color:var(--muted);max-width:570px;margin:0 0 28px}.hero-image{position:relative;overflow:hidden}.hero-image:before{content:"";position:absolute;width:610px;height:610px;border-radius:50%;border:1px solid rgba(99,102,241,.13);left:-45px;top:-115px;box-shadow:0 0 0 54px rgba(99,102,241,.035),0 0 0 108px rgba(99,102,241,.02)}.hero-image img{position:absolute;right:-2%;bottom:-3%;width:105%;height:105%;object-fit:cover;object-position:center;mix-blend-mode:multiply;filter:contrast(1.04)}.landing-actions,.hero-buttons{display:flex;align-items:center;gap:14px;flex-wrap:wrap}.primary-hero,.export-hero,.secondary-hero{border:0;border-radius:13px;padding:15px 20px;display:flex;align-items:center;justify-content:center;gap:12px}.primary-hero,.export-hero{background:linear-gradient(135deg,#5964ff,#9953f5);color:white;min-width:245px;box-shadow:0 14px 28px rgba(99,88,255,.24)}.secondary-hero{background:#fff;border:1px solid var(--line2);min-width:220px;color:#1d2027}.primary-hero>span,.export-hero>span,.secondary-hero>span{font-size:23px}.primary-hero b,.export-hero b,.secondary-hero b{font-size:13px}.primary-hero small,.export-hero small,.secondary-hero small{display:block;font-size:8.5px;margin-top:4px;opacity:.8}.export-hero.small{min-width:180px;padding:11px 14px;font-size:11px}.privacy{font-size:8.5px;color:#858894}.busy-box{width:440px;border:1px solid var(--line);border-radius:12px;padding:16px;background:#fff}.spinner{width:26px;height:26px;border:2px solid #e6e6ec;border-top-color:var(--purple);border-radius:50%;animation:spin .8s linear infinite}.busy-box b{display:block;font-size:11px;margin:8px 0}.busy-box p,.busy-box small{font-size:8.5px;color:var(--muted)}.progress-track{height:5px;border-radius:99px;background:#ececf2;overflow:hidden}.progress-track>div{height:100%;width:0;background:linear-gradient(90deg,#5964ff,#9953f5);transition:width .15s}.error-card{margin-top:14px;border:1px solid #ffd0cd;background:#fff5f4;border-radius:10px;padding:10px 12px;color:#c93731;font-size:9px;display:flex;align-items:center;gap:10px}.error-card button{margin-left:auto;border:0;background:transparent;color:inherit;font-size:16px}.view{display:none}.view.active{display:block}.page-head{display:flex;align-items:end;justify-content:space-between;margin:6px 0 18px}.page-head h1{font-size:29px;margin:5px 0 3px;letter-spacing:-.035em}.page-head p{margin:0;color:var(--muted);font-size:10px}.metrics-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:11px;margin-bottom:16px}.metrics-grid article{background:#fff;border:1px solid var(--line);border-radius:14px;padding:15px 16px;min-height:112px;box-shadow:var(--shadow2);display:flex;flex-direction:column;justify-content:center}.metrics-grid span{font-size:10px;color:#565a65}.metrics-grid strong{font-size:24px;letter-spacing:-.035em;margin:9px 0 7px}.metrics-grid small{font-size:8.5px;color:var(--muted)}.metrics-grid .warn span:before{content:"△";color:var(--orange);margin-right:5px}.dashboard-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(300px,.8fr);gap:14px}.panel{background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden;box-shadow:var(--shadow2)}.panel-head{min-height:58px;padding:14px 16px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.panel-head h2{font-size:13px;margin:0}.panel-head p{font-size:8.5px;color:var(--muted);margin:4px 0 0}.panel-head>span{font-size:8px;color:#858894}.accounting-head,.summary-row{display:grid;grid-template-columns:minmax(160px,1fr) 90px 130px 90px;align-items:center}.accounting-head{padding:10px 16px;font-size:8.5px;color:#8b8e98}.summary-row{padding:10px 16px;border-top:1px solid #f0f0f3;font-size:9.5px;position:relative}.summary-row span,.summary-row b,.summary-row small{text-align:right}.summary-row .share-track{position:absolute;left:16px;bottom:0;height:2px;background:#b9bbc5;opacity:.5}.summary-row.total{background:#fafafd;font-weight:700}.import-summary{padding:8px 16px;margin:0}.import-summary>div{display:flex;justify-content:space-between;gap:16px;padding:6px 0;font-size:9px}.import-summary dt{color:var(--muted)}.import-summary dd{margin:0;font-weight:600;text-align:right}.success-strip{margin:8px 14px 14px;padding:10px;border-radius:9px;background:#effaf2;color:#238b4e;font-size:9px}.link-btn{border:0;background:transparent;color:#5d5fea;font-size:9px}.mini-table{width:100%;border-collapse:collapse;font-size:9px}.mini-table th,.mini-table td{padding:9px 14px;border-bottom:1px solid #f0f0f3;text-align:left}.mini-table th{font-size:8px;color:#8a8d97}.quick-actions{padding:8px}.quick-actions button{width:100%;border:0;background:#fff;padding:11px 10px;border-bottom:1px solid #f0f0f3;display:flex;justify-content:space-between;font-size:9.5px}.quick-actions b{background:#ff9f0a;color:#fff;border-radius:99px;padding:2px 6px;font-size:8px}.filters-bar{display:grid;grid-template-columns:1fr 190px 160px;gap:10px;padding:14px;border-bottom:1px solid var(--line)}.filters-bar label{border:1px solid var(--line);border-radius:9px;padding:0 11px;background:#fafafd}.filters-bar input{border:0;outline:0;background:transparent;width:94%;padding:9px;font-size:9px}.filters-bar select{border:1px solid var(--line);border-radius:9px;background:white;padding:8px;font-size:9px}.table-wrap{overflow:auto}.data-table{width:100%;border-collapse:collapse;min-width:1050px;font-size:9px}.data-table th,.data-table td{padding:9px 12px;border-bottom:1px solid #f0f0f3;text-align:left}.data-table th{background:#fafafd;color:#81848e;font-size:8px;position:sticky;top:0}.product-row,.unknown-row,.sheet-row{padding:11px 16px;border-top:1px solid #f0f0f3;font-size:9px;display:grid;gap:12px}.product-row{grid-template-columns:minmax(220px,1fr) 120px 150px 130px}.unknown-row{grid-template-columns:170px minmax(220px,1fr) 150px 120px}.sheet-row{grid-template-columns:minmax(220px,1fr) minmax(220px,1fr) 130px}.empty{padding:45px;text-align:center;color:var(--muted);font-size:10px}.badge{justify-self:end;padding:4px 7px;border-radius:99px;background:#eef7f0;color:#268351;font-size:8px}.badge.ignored{background:#f1f1f4;color:#777}.badge.rejected{background:#fff4e8;color:#c36e13}.export-panel{padding:24px;display:flex;align-items:center;justify-content:space-between}.export-panel b{font-size:15px}.export-panel p{font-size:9px;color:var(--muted)}
.modal-backdrop{position:fixed;inset:0;background:rgba(20,20,24,.22);backdrop-filter:blur(8px);z-index:100;display:grid;place-items:center}.modal-backdrop[hidden]{display:none!important}.modal-card{width:390px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:24px;box-shadow:0 30px 80px rgba(30,31,40,.18)}.modal-icon{width:38px;height:38px;border-radius:50%;background:#fff0ef;color:var(--red);display:grid;place-items:center}.modal-card h3{font-size:18px;margin:14px 0 7px}.modal-card p{font-size:10px;color:var(--muted);line-height:1.6}.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}.toolbar-button{border:1px solid var(--line2);background:#fff;border-radius:8px;padding:8px 12px;font-size:9px}.toolbar-button.danger{color:var(--red);border-color:#ffc7c4}.toolbar-button.filled{background:#fff5f4}.primary-action{border:0;background:linear-gradient(135deg,#5964ff,#9953f5);color:#fff;border-radius:10px;padding:11px 16px}
@keyframes spin{to{transform:rotate(360deg)}}
@media(max-width:1180px){.metrics-grid{grid-template-columns:repeat(3,1fr)}.landing-hero,.dashboard-hero{grid-template-columns:1.15fr .85fr}.hero-copy h1{font-size:38px}.dashboard-grid{grid-template-columns:1fr}.hero-image img{width:120%}}
@media(max-width:820px){.app-shell{display:block}.sidebar{position:relative;width:auto}.side-nav{grid-template-columns:repeat(3,1fr)}.workspace{grid-column:auto}.landing-hero,.dashboard-hero{grid-template-columns:1fr}.hero-image{display:none}.metrics-grid{grid-template-columns:repeat(2,1fr)}.content{padding:16px}.filters-bar{grid-template-columns:1fr}.top-title{display:none}}

/* v5.3 — readability + editable review */
html{font-size:16px}.app-shell{grid-template-columns:248px 1fr}.sidebar{width:248px;padding:24px 18px 20px}.workspace{grid-column:2}.brand-logo{width:66px;height:66px}.brand-copy strong{font-size:22px}.brand-copy span{font-size:12px}.brand-copy small{font-size:11px}.nav-item{font-size:14px;padding:13px 14px;gap:12px}.nav-item b{font-size:10px}.side-tip b{font-size:13px}.side-tip ol{font-size:11px;line-height:1.75}.side-status>div{font-size:12px}.side-status small{font-size:10.5px}.side-status button{font-size:11px;padding:10px}.topbar{height:70px;padding:0 32px}.top-title{font-size:12px}.ghost-btn,.danger-btn,.dark-btn{font-size:12px;padding:10px 15px}.content{padding:28px 32px 52px}.eyebrow{font-size:11px}.hero-copy>p{font-size:15px;line-height:1.7}.primary-hero b,.export-hero b,.secondary-hero b{font-size:16px}.primary-hero small,.export-hero small,.secondary-hero small{font-size:11px}.privacy{font-size:11px}.page-head h1{font-size:34px}.page-head p{font-size:13px}.metrics-grid article{min-height:126px;padding:18px}.metrics-grid span{font-size:13px}.metrics-grid strong{font-size:29px}.metrics-grid small{font-size:11px}.panel-head{min-height:66px;padding:16px 18px}.panel-head h2{font-size:16px}.panel-head p{font-size:11px}.panel-head>span{font-size:10px}.accounting-head{font-size:11px;padding:12px 18px}.summary-row{font-size:12.5px;padding:12px 18px}.import-summary>div{font-size:12px;padding:8px 0}.success-strip{font-size:12px}.link-btn{font-size:12px}.mini-table{font-size:12px}.mini-table th{font-size:11px}.mini-table th,.mini-table td{padding:11px 16px}.quick-actions button{font-size:12.5px;padding:13px 12px}.quick-actions b{font-size:10px}.filters-bar input,.filters-bar select{font-size:12px}.data-table{font-size:12px}.data-table th{font-size:11px}.data-table th,.data-table td{padding:11px 13px}.product-row,.sheet-row{font-size:12px;padding:13px 18px}.empty{font-size:13px}.badge{font-size:10px}.export-panel b{font-size:18px}.export-panel p{font-size:12px}.modal-card{width:min(460px,calc(100vw - 36px));padding:28px}.modal-card h3{font-size:21px}.modal-card p{font-size:13px}.toolbar-button{font-size:12px;padding:10px 14px}
.review-help{padding:16px 18px;border-bottom:1px solid var(--line);background:#fafafd;color:var(--muted);font-size:12px;line-height:1.65}.review-editor{display:grid;grid-template-columns:180px minmax(220px,1.4fr) minmax(180px,1fr) 180px 150px;gap:12px;align-items:end;padding:16px 18px;border-top:1px solid #eeeeF2;background:#fff}.review-editor:first-child{border-top:0}.review-id{display:grid;gap:4px;align-self:center}.review-id strong{font-size:12px;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.review-id small{font-size:10.5px;color:var(--muted)}.review-editor label{display:grid;gap:6px}.review-editor label>span{font-size:10.5px;color:var(--muted);font-weight:600}.review-editor input,.review-editor select{width:100%;border:1px solid var(--line2);background:#fff;border-radius:9px;padding:10px 11px;font-size:12px;outline:none}.review-editor input:focus,.review-editor select:focus{border-color:#8177ff;box-shadow:0 0 0 3px rgba(98,87,255,.10)}.review-save{border:0;border-radius:9px;padding:11px 12px;background:#16171a;color:#fff;font-size:12px;font-weight:650}.review-save:hover{background:#2a2b30}
@media(max-width:1280px){.review-editor{grid-template-columns:150px 1fr 1fr 160px}.review-save{grid-column:4}.app-shell{grid-template-columns:230px 1fr}.sidebar{width:230px}.workspace{grid-column:2}}
@media(max-width:900px){.review-editor{grid-template-columns:1fr}.review-save{grid-column:auto}.app-shell{display:block}.sidebar{position:relative;width:auto}.workspace{grid-column:auto}}
