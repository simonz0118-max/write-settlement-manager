:root{
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","SF Pro Display","PingFang SC","Helvetica Neue",Arial,sans-serif;
  color:#17171b;background:#f5f5f7;font-synthesis:none;color-scheme:light;
  --bg:#f5f5f7;--sidebar:#fbfbfd;--surface:#fff;--surface-2:#f8f8fa;--line:#e7e7ec;--line-strong:#d8d8df;
  --text:#17171b;--muted:#73737d;--muted-2:#a3a3ad;--blue:#5d63ff;--purple:#9657ff;--green:#24a866;--orange:#f59a23;--red:#e5484d;
  --shadow:0 12px 35px rgba(43,45,66,.07);--shadow-sm:0 5px 16px rgba(43,45,66,.05);
}
*{box-sizing:border-box}html,body{margin:0;min-width:1024px;min-height:100%;background:var(--bg)}button,input,select{font:inherit}button{color:inherit}.app-shell{min-height:100vh;display:grid;grid-template-columns:220px minmax(0,1fr)}
.sidebar{position:fixed;left:0;top:0;bottom:0;width:220px;padding:24px 16px 18px;background:rgba(251,251,253,.94);backdrop-filter:blur(24px);border-right:1px solid var(--line);display:flex;flex-direction:column;z-index:20}.brand-block{display:flex;gap:12px;align-items:center;padding:0 8px 24px}.brand-panda{width:58px;height:48px;object-fit:cover;object-position:center top;mix-blend-mode:multiply}.brand-copy{display:grid}.brand-copy strong{font-size:19px;letter-spacing:.02em}.brand-copy span{font-size:11px;color:#4f5058}.brand-copy small{font-size:10px;color:var(--muted-2);margin-top:5px}.side-nav{display:grid;gap:5px}.nav-item{position:relative;width:100%;border:0;background:transparent;display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:9px;color:#32323a;font-size:13px;cursor:pointer;text-align:left}.nav-item>span{width:19px;text-align:center;font-size:17px;color:#666875}.nav-item:hover{background:#f1f1f5}.nav-item.active{background:#eceeff;color:#4a4ff0;font-weight:650}.nav-item.active>span{color:#4a4ff0}.nav-item b{margin-left:auto;background:#f38b20;color:#fff;font-size:9px;min-width:20px;height:20px;border-radius:10px;display:grid;place-items:center;padding:0 6px}.tips-card{margin-top:auto;background:#fff;border:1px solid var(--line);border-radius:12px;padding:13px 14px;box-shadow:var(--shadow-sm)}.tips-card strong{font-size:11px}.tips-card ol{padding-left:17px;margin:8px 0 0;color:var(--muted);font-size:9.5px;line-height:1.8}.system-card{margin-top:10px;padding:11px 13px}.ready-row{display:flex;gap:8px;align-items:center;font-size:10.5px}.ready-row i{width:7px;height:7px;border-radius:50%;background:#c4c4ca}.system-card.ready .ready-row i{background:#34c759;box-shadow:0 0 0 4px rgba(52,199,89,.10)}.system-card small{display:block;font-size:8.8px;color:var(--muted);margin:6px 0 10px}.secondary-action{width:100%;border:1px solid var(--line);background:#fff;border-radius:8px;padding:8px;font-size:9.5px;cursor:pointer}.secondary-action:disabled{opacity:.45;cursor:not-allowed}
.workspace{grid-column:2;min-width:0}.workspace-bar{height:62px;border-bottom:1px solid rgba(231,231,236,.8);display:flex;align-items:center;justify-content:center;padding:0 26px;position:sticky;top:0;background:rgba(245,245,247,.82);backdrop-filter:blur(24px);z-index:10}.window-title{font-size:11px;color:#6f7079}.top-actions{position:absolute;right:24px;display:flex;gap:8px}.toolbar-button{border:1px solid var(--line-strong);background:#fff;border-radius:9px;padding:8px 12px;font-size:10.5px;cursor:pointer;box-shadow:0 1px 2px rgba(0,0,0,.02)}.toolbar-button:hover{background:#fafafd}.toolbar-button.danger{color:var(--red);border-color:#f0c6c8}.toolbar-button.danger.filled{background:#fff2f3}.primary-compact{background:#1f1f24;color:#fff;border-color:#1f1f24}.content{padding:22px 28px 36px;max-width:1440px;margin:0 auto}.eyebrow{font-size:9px;letter-spacing:.11em;font-weight:700;color:#7f8190}.page-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:18px}.page-head h1{font-size:28px;margin:3px 0 4px;letter-spacing:-.035em}.page-head p{margin:0;color:var(--muted);font-size:11px}.page-head.compact{margin-bottom:16px}
.import-landing{margin:4vh auto 0;max-width:1180px}.landing-card,.hero-panel{min-height:440px;border:1px solid #ececf1;border-radius:20px;background:linear-gradient(135deg,#fff 0%,#fff 48%,#f4f3ff 100%);box-shadow:var(--shadow);overflow:hidden;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(360px,.85fr);position:relative}.landing-copy,.hero-copy{padding:56px 30px 50px 50px;position:relative;z-index:2}.landing-copy h1,.hero-copy h1{font-size:48px;line-height:1.04;letter-spacing:-.055em;margin:9px 0 17px}.landing-copy h1 em,.hero-copy h1 em{font-style:normal;background:linear-gradient(90deg,#5664ff,#9857ff);-webkit-background-clip:text;color:transparent}.landing-copy>p,.hero-copy>p{max-width:590px;color:var(--muted);font-size:13px;line-height:1.8;margin:0 0 28px}.landing-art,.hero-art{position:relative;overflow:hidden}.landing-art:before,.hero-art:before{content:"";position:absolute;width:590px;height:590px;border-radius:50%;border:1px solid rgba(99,102,241,.14);left:-70px;top:-120px;box-shadow:0 0 0 54px rgba(99,102,241,.035),0 0 0 108px rgba(99,102,241,.018)}.landing-art img,.hero-art img{position:absolute;right:-12px;bottom:-4px;width:104%;height:102%;object-fit:cover;object-position:center;border-radius:0;mix-blend-mode:multiply;filter:contrast(1.04)}.dropzone{display:block}.landing-actions{display:flex;align-items:center;gap:16px;flex-wrap:wrap}.privacy-note{font-size:9px;color:#8b8d98}.primary-action,.hero-import,.hero-export{border:0;cursor:pointer}.hero-primary,.hero-export{min-width:270px;background:linear-gradient(135deg,#5963ff,#9a52f5);color:#fff;border-radius:13px;padding:15px 20px;display:flex;align-items:center;justify-content:center;gap:13px;box-shadow:0 12px 26px rgba(101,91,255,.24)}.hero-primary span,.hero-export>span{font-size:25px}.hero-primary b,.hero-export b{font-size:14px}.hero-primary small,.hero-export small{display:block;font-size:9px;opacity:.82;margin-top:4px}.hero-primary:hover,.hero-export:hover{transform:translateY(-1px);box-shadow:0 16px 30px rgba(101,91,255,.28)}.spinner{width:28px;height:28px;border:2px solid #e1e1e8;border-top-color:#5d63ff;border-radius:50%;animation:spin .8s linear infinite;margin-bottom:12px}.progress-track{width:100%;height:5px;background:#ececf2;border-radius:99px;overflow:hidden;margin:15px 0 7px}.progress-fill{height:100%;width:0;background:linear-gradient(90deg,#5963ff,#9a52f5);transition:width .12s}.current-file{max-width:470px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.error-inline{margin-top:12px;border:1px solid #f2c9cb;background:#fff4f4;border-radius:10px;padding:11px 12px;display:flex;gap:10px;color:#d84348}.error-inline>span{width:19px;height:19px;border:1px solid currentColor;border-radius:50%;display:grid;place-items:center;font-size:10px}.error-inline b{font-size:11px}.error-inline p{font-size:10px;margin:2px 0 0;color:#a05e60}.error-inline button{margin-left:auto;border:0;background:transparent;color:inherit;cursor:pointer;font-size:18px}
.view{display:none}.view.active{display:block}.hero-panel{min-height:360px;margin-bottom:18px}.hero-copy{padding:38px 34px 34px 46px}.hero-copy h1{font-size:42px}.hero-actions{display:flex;gap:14px}.hero-import{min-width:210px;background:#fff;border:1px solid var(--line-strong);border-radius:13px;padding:14px 17px;display:flex;align-items:center;justify-content:center;gap:12px;box-shadow:var(--shadow-sm)}.hero-import>span{font-size:23px}.hero-import b{font-size:13px}.hero-import small{display:block;color:var(--muted);font-size:9px;margin-top:4px}.feature-pills{display:flex;gap:8px;flex-wrap:wrap;margin-top:20px}.feature-pills span{font-size:9px;color:#555865;background:rgba(255,255,255,.8);border:1px solid #ececf2;border-radius:999px;padding:6px 9px}.standalone{min-width:300px}
.metrics-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:11px;margin-bottom:16px}.metric-card{min-height:110px;border:1px solid var(--line);background:#fff;border-radius:13px;padding:15px;display:flex;flex-direction:column;justify-content:center;box-shadow:var(--shadow-sm)}.metric-card span{font-size:10px;color:#555761}.metric-card strong{font-size:23px;letter-spacing:-.035em;margin:9px 0 7px;font-weight:650}.metric-card small{font-size:8.8px;color:var(--muted);line-height:1.35}.metric-card.warn span:before{content:"△";color:var(--orange);margin-right:5px}.dashboard-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(290px,.8fr);gap:14px}.panel{border:1px solid var(--line);background:#fff;border-radius:13px;overflow:hidden;box-shadow:var(--shadow-sm)}.panel-title{min-height:58px;padding:14px 16px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.panel-title h2{font-size:13px;margin:0}.panel-title p{font-size:8.8px;color:var(--muted);margin:3px 0 0}.text-button{border:0;background:transparent;color:#5a5fe8;font-size:9.5px;cursor:pointer}.accounting-table-head,.summary-row{display:grid;grid-template-columns:minmax(150px,1fr) 88px 130px 86px;align-items:center}.accounting-table-head{padding:10px 16px;font-size:8.8px;color:#8a8c96}.summary-row{position:relative;padding:10px 16px;border-top:1px solid #f0f0f3;font-size:10px}.summary-row strong{font-weight:600}.summary-row span,.summary-row b,.summary-row small{text-align:right}.summary-row b{font-weight:600}.summary-row small{color:var(--muted)}.summary-row .share-track{position:absolute;left:16px;bottom:0;height:2px;max-width:calc(100% - 32px);background:#bcbec9;opacity:.55}.summary-row.total{background:#fafafd;font-weight:700}.import-summary{padding:11px 16px;margin:0}.import-summary>div{display:flex;justify-content:space-between;gap:18px;padding:7px 0;font-size:9.5px}.import-summary dt{color:var(--muted)}.import-summary dd{margin:0;font-weight:600;text-align:right}.success-strip{margin:0 14px 14px;padding:10px 11px;border-radius:9px;background:#effaf3;color:#208f52;display:flex;gap:9px;align-items:center}.success-strip>span{width:18px;height:18px;border:1px solid currentColor;border-radius:50%;display:grid;place-items:center;font-size:10px}.success-strip b{font-size:10px}.success-strip small{display:block;color:#69947d;font-size:8.3px;margin-top:2px}.recent-panel{grid-column:1}.quick-panel{grid-column:2}.mini-table{width:100%;border-collapse:collapse;font-size:9.5px}.mini-table th,.mini-table td{padding:9px 15px;border-bottom:1px solid #f0f0f3;text-align:left}.mini-table th{font-size:8.5px;color:#8b8d96;font-weight:500}.tag,.accounting-pill{display:inline-flex;padding:4px 7px;border-radius:999px;background:#f0efff;color:#5f59d8;font-size:8.5px}.quick-actions{padding:10px 13px 14px;display:grid;gap:8px}.quick-actions button{width:100%;border:1px solid var(--line);background:#fff;border-radius:9px;padding:10px 11px;display:flex;align-items:center;text-align:left;font-size:9.5px;cursor:pointer}.quick-actions button:hover{background:#fafafd}.quick-actions button span{margin-left:auto}.quick-actions button b{margin-left:auto;margin-right:8px;background:#f38b20;color:white;border-radius:999px;padding:2px 6px;font-size:8px}
.filters-bar{display:grid;grid-template-columns:1fr 190px 160px;gap:10px;padding:14px;border-bottom:1px solid var(--line)}.search-box{display:flex;align-items:center;gap:7px;border:1px solid var(--line);background:#fafafd;border-radius:9px;padding:0 11px}.search-box input{border:0;background:transparent;outline:0;width:100%;padding:9px 0;font-size:10px}.filters-bar select{border:1px solid var(--line);background:#fff;border-radius:9px;padding:8px 10px;font-size:9.5px}.table-wrap{overflow:auto}.data-table{width:100%;border-collapse:collapse;font-size:9.5px;min-width:1050px}.data-table th,.data-table td{padding:9px 12px;border-bottom:1px solid #f0f0f3;text-align:left}.data-table th{position:sticky;top:0;background:#fafafd;color:#7f818b;font-size:8.5px;font-weight:600}.mono{font-variant-numeric:tabular-nums}.muted{color:var(--muted)}.product-cell{max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.table-note{padding:12px;text-align:center;color:var(--muted);font-size:9px}.product-summary{display:grid}.product-row{display:grid;grid-template-columns:minmax(220px,1fr) 130px 170px 150px;padding:12px 16px;border-top:1px solid #f0f0f3;font-size:9.5px}.product-row span,.product-row small{text-align:right}.product-row small{color:var(--muted)}.unknown-list,.sheet-list{display:grid}.unknown-row,.sheet-row{display:grid;grid-template-columns:180px minmax(250px,1fr) 160px 120px;gap:14px;align-items:center;padding:11px 16px;border-top:1px solid #f0f0f3;font-size:9.5px}.sheet-row{grid-template-columns:minmax(220px,1fr) minmax(220px,1fr) 150px}.empty-state{padding:48px;text-align:center;color:var(--muted)}.badge{justify-self:end;padding:4px 7px;border-radius:999px;background:#eef6f0;color:#278552;font-size:8px}.badge.ignored{background:#f2f2f5;color:#777984}.badge.rejected{background:#fff4e8;color:#c77316}.export-card{padding:24px;display:flex;align-items:center;justify-content:space-between;gap:20px}.report-preview{display:flex;gap:14px;align-items:center}.report-icon{width:48px;height:48px;border-radius:12px;background:#f0efff;color:#5e59dd;display:grid;place-items:center;font-size:22px}.report-preview h2{font-size:15px;margin:0}.report-preview p{font-size:9.5px;color:var(--muted);margin:5px 0 0}.modal-backdrop{position:fixed;inset:0;background:rgba(20,20,24,.2);backdrop-filter:blur(6px);z-index:99;display:grid;place-items:center}.modal-card{width:390px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:24px;box-shadow:0 30px 80px rgba(30,31,40,.18)}.modal-icon{width:38px;height:38px;border-radius:50%;background:#fff0f0;color:var(--red);display:grid;place-items:center}.modal-card h3{font-size:18px;margin:14px 0 7px}.modal-card p{color:var(--muted);font-size:10.5px;line-height:1.6}.modal-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}
@keyframes spin{to{transform:rotate(360deg)}}
@media(max-width:1180px){.metrics-grid{grid-template-columns:repeat(3,1fr)}.hero-panel,.landing-card{grid-template-columns:1.15fr .85fr}.hero-copy h1,.landing-copy h1{font-size:38px}.dashboard-grid{grid-template-columns:1fr}.quick-panel,.recent-panel{grid-column:auto}.hero-actions{flex-wrap:wrap}}
